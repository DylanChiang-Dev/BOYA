{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boya Desktop",
  "version": "0.1.0",
  "identifier": "dev.dylanchiang.boya",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @boya/desktop exec vite --port 5173 --strictPort",
    "beforeBuildCommand": "pnpm --filter @boya/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Boya Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "zoomHotkeysEnabled": true,
        "trafficLightPosition": { "x": 13, "y": 22 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/opencode", "binaries/uv"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../../runtime/skills/external/boya": "skills-boya/",
      "../../../runtime/skills/external/anthropic-skills": "skills-office/",
      "../../../runtime/skills/core/traceability-review": "skills-core/traceability-review/",
      "../../../runtime/skills/core/stats-integrity": "skills-core/stats-integrity/",
      "../../../runtime/skills/core/large-file": "skills-core/large-file/",
      "../../../runtime/skills/core/publication-figures": "skills-core/publication-figures/",
      "../../../runtime/harness": "harness/",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../LICENSES/open-science-MIT.txt": "LICENSES/open-science-MIT.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
